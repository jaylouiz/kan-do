<!--
@component PrototypeSwitcher
@description PROTOTYPE ONLY (#<n>). Fixed pill that switches `?variant=`; arrow keys outside inputs. Never gated on dev mode.
@usage Copy to components/prototype/PrototypeSwitcher.vue on a proto branch, edit LABELS only (key `o` = today's look), mount once in the host page.
-->
<template>
  <div v-if="current" class="proto-switcher" role="group" aria-label="Variant switcher">
    <button type="button" aria-label="Previous variant" @click="step(-1)">‹</button>
    <span><b>{{ current.toUpperCase() }}</b> {{ LABELS[current] }}</span>
    <button type="button" aria-label="Next variant" @click="step(1)">›</button>
  </div>
</template>

<script setup lang="ts">
import { onBeforeUnmount, onMounted } from 'vue'

defineOptions({ name: 'PrototypeSwitcher' })

const LABELS: Record<string, string> = { o: 'Today', a: '<variant a name>', b: '<variant b name>' }
const KEYS = Object.keys(LABELS)
const route = useRoute()
const router = useRouter()
const current = computed(() => {
  const v = route.query.variant
  return typeof v === 'string' && v in LABELS ? v : null
})
function step(dir: 1 | -1) {
  const i = KEYS.indexOf(current.value ?? 'o')
  router.replace({ query: { ...route.query, variant: KEYS[(i + dir + KEYS.length) % KEYS.length] } })
}
function onKey(e: KeyboardEvent) {
  const t = e.target as HTMLElement | null
  if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return
  if (e.metaKey || e.ctrlKey || e.altKey) return
  if (e.key === 'ArrowLeft' && current.value) step(-1)
  if (e.key === 'ArrowRight' && current.value) step(1)
}
onMounted(() => window.addEventListener('keydown', onKey))
onBeforeUnmount(() => window.removeEventListener('keydown', onKey))
</script>

<style>
.proto-switcher {
  position: fixed; z-index: 3000; left: 1rem; bottom: 1rem;
  display: flex; align-items: center; gap: .5rem;
  padding: .25rem .5rem; border-radius: 999px;
  background: #111; color: #fff; font: 500 .8125rem/1 system-ui, sans-serif;
  box-shadow: 0 4px 16px rgba(0,0,0,.35);
}
.proto-switcher button { color: #fff; font-size: 1.25rem; line-height: 1; padding: .25rem .5rem; cursor: pointer; }
@media (max-width: 767px) { .proto-switcher { left: 50%; transform: translateX(-50%); bottom: calc(8rem + env(safe-area-inset-bottom, 0px)); } }
</style>
