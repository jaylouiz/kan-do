{
  "name": "kan-do",
  "private": true,
  "version": "0.12.0",
  "description": "The focused today board — local, Todoist or Notion",
  "author": "Julius Wüstefeld",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaylouiz/kan-do.git"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:e2e": "E2E_NOTION_STUB=1 nuxt dev",
    "dev:seed": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "preview:e2e": "E2E_NOTION_STUB=1 nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "lint:strict": "eslint . --max-warnings=0",
    "lint:ci": "eslint . --quiet",
    "motion:film": "node scripts/motion-film.mts",
    "ratchet:lower": "node scripts/lint/ratchets.mjs --update",
    "design:detect": "impeccable detect --quiet components pages layouts assets app.vue",
    "verify": "npm run lint:ci && npm run typecheck && npm run design:detect && vitest run",
    "release": "node scripts/release.mjs",
    "notion:sandbox": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/notion-sandbox.mts",
    "test:contract": "NOTION_SANDBOX=1 vitest run tests/contract",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "i18n:check": "vitest run tests/i18n",
    "terms:approve": "node scripts/copy-terms.mjs approve",
    "ui:manifest": "node scripts/ui-manifest.mjs",
    "ui:find": "node scripts/ui-find.mjs",
    "copy:concepts": "node scripts/copy-concepts.mjs",
    "tauri": "~/.cargo/bin/cargo tauri",
    "tauri:dev": "~/.cargo/bin/cargo tauri dev",
    "tauri:build": "~/.cargo/bin/cargo tauri build",
    "tauri:bundle": "~/.cargo/bin/cargo tauri bundle",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.76",
    "@iconify/collections": "^1.0.762",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@nuxt/devtools": "^3.4.3",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/schema": "^4.6.4",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.2.0",
    "eslint-plugin-better-tailwindcss": "^4.5.0",
    "h3": "^1.15.11",
    "impeccable": "4.8.0",
    "jsdom": "^29.0.1",
    "playwright": "^1.59.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.1",
    "@dnd-kit/vue": "^0.5.1",
    "@doist/todoist-api-typescript": "^7.10.0",
    "@formkit/auto-animate": "^0.9.0",
    "@internationalized/date": "^3.12.4",
    "@notionhq/client": "^5.16.0",
    "@nuxt/fonts": "^1.0.1",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-http": "^2.5.8",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@vueuse/core": "^14.4.0",
    "dompurify": "^3.4.17",
    "marked": "^17.0.6",
    "motion-v": "^2.2.0",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "overrides": {
    "vaul-vue": {
      "@vueuse/core": "^14.4.0"
    },
    "@doist/todoist-sdk": "17.0.0",
    "@nuxt/ui": {
      "esbuild": "^0.28.2"
    },
    "glob@>=9.0.0 <14.0.2": "^14.0.4",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  }
}
