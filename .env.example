NOTION_KEY=<your-notion-api-key>
NOTION_PAGE_ID=<parent-page-id>

# Todoist OAuth app credentials (from https://developer.todoist.com/appconsole.html)
TODOIST_CLIENT_ID=<your-todoist-client-id>
TODOIST_CLIENT_SECRET=<your-todoist-client-secret>

# Feedback relay (server only, #268): fine-grained GitHub token limited to the feedback repository
# (Issues: write, Contents: write). Without it POST /api/feedback answers 503 and the app falls back to GitHub.
FEEDBACK_GITHUB_TOKEN=<fine-grained-token-for-the-feedback-repo>
# FEEDBACK_REPO=<owner>/<repo>   # default jaylouiz/kan-do-feedback
