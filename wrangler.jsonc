// Worker `kando` (#279, #502, ADR 021): the public web instance on Cloudflare Workers Free, behind the secret-launch gate.
// Deploy: Workers Builds runs `npm run build:cloudflare` (fails when the bundle lacks the gate), then `npx wrangler deploy`, on every push
// to main; by hand `npm run deploy` does both. A `proto/*` branch gets a gated Worker Preview (`npm run preview:cloudflare`), any
// other branch builds nothing (`scripts/workers-preview.mjs`). Nitro's own wrangler config stays off (`cloudflare.deployConfig`).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kando",
  "main": "worker/index.ts",
  // Not newer than the workerd of the pinned wrangler (4.156.2 ships 2026-11-02 builds).
  "compatibility_date": "2026-11-02",
  // `Buffer` in the feedback relay, `process.env` filled from vars and secrets.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // On: one switch (the workers.dev subdomain's `previews_enabled`) gives Worker Previews their URL and Version URLs theirs.
  // Prototypes reach Cloudflare only as Worker Previews (`previews` block below: no production secret); a Version URL only
  // ever shows a version `wrangler deploy` uploaded from main, i.e. production code and secrets on another host, gated alike.
  "preview_urls": true,
  // Custom domain (#32): Wrangler attaches it on deploy. Needs zone julius-wuestefeld.de active and no conflicting DNS record.
  // Gate stays on; workers.dev URL stays on for previews.
  "routes": [
    { "pattern": "kan-do.julius-wuestefeld.de", "custom_domain": true },
  ],
  // Nitro's built handler: the output of `npm run build:cloudflare`.
  "alias": { "#nitro-server": "./.output/server/index.mjs" },
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    // Every request, static files included, passes the gate: nothing leaks to visitors without the token.
    // Each one counts as an invocation (Free: 100,000/day).
    "run_worker_first": true,
  },
  // GATE: on in every fresh deploy; this line is the single source (the dashboard value is reset by each deploy). "off" opens the app for
  // the public launch (jwue-homepage#34): change it here, through a PR. The token is the secret GATE_SECRET
  // (the homepage's value, one shared token). Other secrets: FEEDBACK_GITHUB_TOKEN (missing = the relay answers 503;
  // `npm run feedback:check` and the daily workflow "Feedback relay check" find it, #852). Never NOTION_KEY.
  "vars": { "GATE": "on" },
  // Worker Previews of `proto/*` branches (ADR 021 "Prototype previews", `npm run preview:cloudflare`): a preview inherits
  // no production var or secret, only these vars and the dashboard's Preview base config (there: GATE_SECRET, never
  // FEEDBACK_GITHUB_TOKEN). The gate stays on; the feedback relay validates a report and files nothing (FEEDBACK_RELAY).
  "previews": { "vars": { "GATE": "on", "FEEDBACK_RELAY": "dry-run" } },
  // No Notion on this instance (#742, ADR 021 "Local-only"): its routes are not in the build and the Worker answers
  // `/api/notion/*` with 404. The Notion proxy's rate limiter (Durable Object `NotionLimiter`, #508) went with them: v2 deletes
  // the class and its stored windows. Keep v1: wrangler replays the migration history by tag.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NotionLimiter"] },
    { "tag": "v2", "deleted_classes": ["NotionLimiter"] },
  ],
  // Workers Logs (#530, #511, epic #279: the Worker stores nothing of the user's). They stay on, so the allow-listed
  // `[server-error] route status code` line (`server/utils/serverLog.ts`) can diagnose an outage, but nothing else of a
  // request persists: invocation logs (URL, Cloudflare request fields) are off and query strings are redacted. Sampling stays
  // at 1 so a rare error is not lost. Lost on purpose: per-request path/status/CPU lines; the dashboard's request and error metrics stay.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
  },
}
